# ASIL Logistics - Environment Configuration
PORT=3000
NODE_ENV=production

# Session Signing Secret (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
SESSION_SECRET=replace_with_generated_random_secret_hex

# Optional SQLite Database Path (defaults to ./asil.db)
# DB_PATH=/var/data/asil.db

# Seed Demo Fleet & Drivers (set to true only for local testing / demos)
SEED_DEMO=false

# Google Play Android TWA Configuration (Optional - for Trusted Web Activity & /.well-known/assetlinks.json)
# ANDROID_PACKAGE=com.asillogistics.app
# ANDROID_SHA256=14:6D:E9:01:...,28:9B:A3:...
